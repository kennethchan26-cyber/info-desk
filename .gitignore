# Whitelist only reviewed public application files. Do not upload the whole folder.
/*
!/.gitignore
!/.nojekyll
!/index.html
!/styles.css
!/app.js
!/config.js
!/manifest.json
!/background.js
!/icon.svg
!/apple-touch-icon.png
!/site.webmanifest
!/README.md
!/market-calendar.js
!/broadcast.js
!/signals.js
!/i18n.js
!/forex.js
!/public-data.js
!/transit-order.js
!/news-extra.js
!/pwa.js
!/sw.js
!/app.webmanifest
!/icon-192.png
!/icon-512.png
!/icon-maskable-512.png
!/barlow-condensed.woff2
!/FONT-LICENSE.txt
