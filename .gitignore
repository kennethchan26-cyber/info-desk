# Whitelist only reviewed public application files. Do not upload the whole folder.
/*
!/.gitignore
!/.nojekyll
!/index.html
!/styles.css
!/app.js
!/config.js
!/manifest.json
!/background.js
!/icon.svg
!/apple-touch-icon.png
!/site.webmanifest
!/README.md
!/market-calendar.js
!/broadcast.js
!/signals.js
!/i18n.js
!/forex.js
!/public-data.js
!/transit-order.js
!/news-extra.js
!/pwa.js
!/sw.js
!/app.webmanifest
!/icon-192.png
!/icon-512.png
!/icon-maskable-512.png
!/barlow-condensed.woff2
!/FONT-LICENSE.txt
!/tv.css
!/tv.js
!/tv-panels.js
!/display.css
!/display.js
!/charts.css
!/charts.js
!/chart-widget.html
!/chart-widget.js
!/lightweight-charts.standalone.production.js
!/LIGHTWEIGHT-CHARTS-LICENSE.txt
!/LIGHTWEIGHT-CHARTS-NOTICE.txt

!/bus-preview.js
!/nasdaq100.js
!/heatmap.js
!/tv-rail.js
!/longbridge-data.js
!/market-pulse.js
!/market-pulse.css
!/LONGBRIDGE.md
!/publisher/
/publisher/*
!/publisher/collect.py
!/publisher/export-config.cjs
!/publisher/install-task.ps1
!/publisher/control-task.ps1
!/publisher/connect-windows.ps1
# Credentials, generated snapshots, local deployment workspaces and logs stay private.
.env*
**/*token*
**/*secret*
**/*.log
**/__pycache__/
/market.json
!/lite.html
!/lite.js
!/lite-config.json
!/LITE.md
!/data/
/data/*
!/data/lite.json
!/.github/
/.github/*
!/.github/workflows/
/.github/workflows/*
!/.github/workflows/lite-pages.yml
!/publisher/lite-config.cjs
!/publisher/lite-snapshot.py
