# Whitelist only reviewed public application files. Do not upload the whole folder.
/*
!/.gitignore
!/.nojekyll
!/index.html
!/styles.css
!/app.js
!/config.js
!/manifest.json
!/background.js
!/icon.svg
!/apple-touch-icon.png
!/site.webmanifest
!/README.md
!/market-calendar.js
!/broadcast.js
!/signals.js
!/i18n.js
!/forex.js
